# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# demo | production
#   demo       → tolera TODOs de onboarding, routing puede ser LOG, registra gaps
#   production → estricto: un workflow habilitado con TODO crítico es error
APP_MODE=demo

PORT=3000

# URL pública EXACTA con la que Twilio golpea este servidor (sin slash final).
# Debe coincidir carácter por carácter con lo configurado en la consola de Twilio,
# porque la firma X-Twilio-Signature se calcula sobre esa URL completa.
# Ej: https://abcd-1234.ngrok-free.app
PUBLIC_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Cualquier modelo con soporte de Responses API + file_search + structured outputs
OPENAI_MODEL=gpt-5.4-mini
# Timeout duro por llamada (ms)
OPENAI_TIMEOUT_MS=45000

# ─────────────────────────────────────────────────────────────────────────────
# Twilio
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender real en formato whatsapp:+E164
TWILIO_WHATSAPP_FROM=whatsapp:+15551234567
# Validación de firma. Default true. Solo desactivar para pruebas locales.
TWILIO_VALIDATE_SIGNATURE=true

# ─────────────────────────────────────────────────────────────────────────────
# Persistencia
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=file:./data/app.db

# ─────────────────────────────────────────────────────────────────────────────
# Comportamiento del pipeline
# ─────────────────────────────────────────────────────────────────────────────
# Ventana de agrupación de mensajes rápidos consecutivos antes de responder
INBOUND_DEBOUNCE_MS=1500
# Intervalo de polling del worker in-process
WORKER_POLL_MS=400
# Reintentos máximos por job
JOB_MAX_ATTEMPTS=3
# Retención de datos
DATA_RETENTION_DAYS=90

# ─────────────────────────────────────────────────────────────────────────────
# Evals
# ─────────────────────────────────────────────────────────────────────────────
RUN_LIVE_EVALS=false

# ─────────────────────────────────────────────────────────────────────────────
# Routing por email (OPCIONAL — el MVP funciona con el adapter LOG)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=debug
# Enmascarar PII en logs. Default: true si NODE_ENV=production
LOG_REDACT_PII=
